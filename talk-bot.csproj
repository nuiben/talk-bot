<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- System.Speech is Windows-only; other hosts build the portable TFM
         and use a command line synthesizer instead. -->
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <RootNamespace>talk</RootNamespace>
    <AssemblyName>talk-bot</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Selenium.WebDriver" Version="4.16.2" />
    <PackageReference Include="System.Speech" Version="9.0.0" Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>

</Project>
